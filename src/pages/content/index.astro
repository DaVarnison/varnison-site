---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('content')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Content · Varnison"><h1>Content</h1>
<div class="grid">{items.map((e) => <Card entry={e} kind="content" />)}</div></Base>
