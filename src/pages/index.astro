---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection, getEntry, render } from 'astro:content';
const bio = await getEntry('site', 'bio');
const { Content } = await render(bio!);
const c = (await getCollection('content')).map((e) => ({ e, kind: 'content' }));
const p = (await getCollection('projects')).map((e) => ({ e, kind: 'projects' }));
const latest = [...c, ...p].sort((a, b) => +b.e.data.date - +a.e.data.date)[0];
---
<Base title="Varnison">
  <section class="hero"><div class="hname">VARNISON</div><img src="/images/hero-chill.jpg" alt="Varnison relaxing on the clouds" /><div class="htag"><p class="meta">Creator · Gamer · Aspiring studio founder</p><p class="tagline">&gt; building games, mods, apps<span class="cursor">_</span></p></div></section>
<style>
.hero{position:relative;max-width:820px;margin:0 auto;text-align:center;padding-top:.5rem}
.hname{position:absolute;left:0;right:0;top:-2%;font-family:var(--mono);font-weight:800;font-size:clamp(2.2rem,9vw,5.5rem);letter-spacing:.12em;color:rgba(255,255,255,.92);text-shadow:0 0 30px #7c3aed,0 0 60px #3b82f6;z-index:0}
.hero img{position:relative;z-index:1;width:100%;height:auto;display:block;mix-blend-mode:screen;-webkit-mask-image:radial-gradient(ellipse 70% 75% at 50% 50%,#000 60%,transparent 100%);mask-image:radial-gradient(ellipse 70% 75% at 50% 50%,#000 60%,transparent 100%)}
.hero{margin-top:2.5rem}.htag{position:relative;z-index:2;margin-top:-2.2rem}
</style>
  <section class="panel"><h2 style="margin-top:0">About me</h2><Content /></section>
  {latest && <section><h2>Latest</h2><div class="grid" style="grid-template-columns:minmax(260px,420px)"><Card entry={latest.e} kind={latest.kind} /></div></section>}
</Base>
