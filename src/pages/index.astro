---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection, getEntry, render } from 'astro:content';
const bio = await getEntry('site', 'bio');
const { Content } = await render(bio!);
const c = (await getCollection('content')).map((e) => ({ e, kind: 'content' }));
const p = (await getCollection('projects')).map((e) => ({ e, kind: 'projects' }));
const latest = [...c, ...p].sort((a, b) => +b.e.data.date - +a.e.data.date)[0];
---
<Base title="Varnison">
  <section style="padding:0 0 1rem"><img src="/images/hero.jpg" alt="Varnison" style="width:100%;height:auto;display:block;border-radius:16px;border:1px solid rgba(167,139,250,.4);box-shadow:0 0 30px rgba(124,58,237,.5)" /><p class="meta" style="text-align:center">Creator · Gamer · Aspiring studio founder</p><p class="tagline" style="text-align:center">&gt; building games, mods, apps<span class="cursor">_</span></p></section>
  <section class="panel"><h2 style="margin-top:0">About me</h2><Content /></section>
  {latest && <section><h2>Latest</h2><div class="grid" style="grid-template-columns:minmax(260px,420px)"><Card entry={latest.e} kind={latest.kind} /></div></section>}
</Base>
