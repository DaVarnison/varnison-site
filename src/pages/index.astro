---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection, getEntry, render } from 'astro:content';
const bio = await getEntry('site', 'bio');
const { Content } = await render(bio!);
const c = (await getCollection('content')).map((e) => ({ e, kind: 'content' }));
const p = (await getCollection('projects')).map((e) => ({ e, kind: 'projects' }));
const latest = [...c, ...p].sort((a, b) => +b.e.data.date - +a.e.data.date)[0];
---
<Base title="Varnison">
  <section style="text-align:center;padding:1rem 0">
    <img src="/images/avatar.png" alt="Varnison avatar" width="160" height="160" style="border-radius:50%;box-shadow:0 0 30px #a78bfa" />
    <h1 style="font-size:clamp(2.2rem,8vw,4rem);margin:.3rem 0">VARNISON</h1>
    <p class="meta">Creator · Gamer · Aspiring studio founder</p>
    <p class="tagline">&gt; building games, mods, apps<span class="cursor">_</span></p>
  </section>
  <section class="panel"><h2 style="margin-top:0">About me</h2><Content /></section>
  {latest && <section><h2>Latest</h2><div class="grid" style="grid-template-columns:minmax(260px,420px)"><Card entry={latest.e} kind={latest.kind} /></div></section>}
</Base>
