---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection, getEntry, render } from 'astro:content';
const bio = await getEntry('site', 'bio');
const { Content } = await render(bio!);
const c = (await getCollection('content')).map((e) => ({ e, kind: 'content' }));
const p = (await getCollection('projects')).map((e) => ({ e, kind: 'projects' }));
const latest = [...c, ...p].sort((a, b) => +b.e.data.date - +a.e.data.date)[0];
---
<Base title="Varnison | Creator, Gamer & Aspiring Studio Founder" description="Varnison is a creator and gamer building games, mods and apps. Watch videos, browse projects and follow the journey to starting a game studio.">
  <h1 class="sr">Varnison</h1><section class="hero"><div class="htag"><p class="meta">Creator · Gamer · Aspiring studio founder</p><p class="tagline">&gt; building games, mods, apps<span class="cursor">_</span></p></div><img src="/images/hero-chill.png" alt="Varnison relaxing on the clouds" /></section>
<style>
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.hero{position:relative;max-width:760px;margin:0 auto -2px;text-align:center;padding-top:.5rem;z-index:1}
.hero img{position:relative;width:100%;height:auto;display:block;margin-bottom:-4px;}
.htag p{margin:.2rem 0}
</style>
  <section class="panel"><h2 style="margin-top:0">About me</h2><Content /></section>
  {latest && <section><h2>Latest</h2><div class="grid" style="grid-template-columns:minmax(260px,420px)"><Card entry={latest.e} kind={latest.kind} /></div></section>}
</Base>
