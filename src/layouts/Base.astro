---
import { socials } from '../lib';
const { title = 'Varnison', description = 'Varnison: content, projects and tech.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['/', 'Home'], ['/content/', 'Content'], ['/projects/', 'Projects']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<link rel="icon" type="image/png" href="/images/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet" />
</head>
<body>
<div class="sky"></div>
<header>
  <a class="brand" href="/"><img src="/images/v.png" alt="" width="40" height="40" /> VARNISON</a>
  <nav>{nav.map(([h, l]) => <a href={h} class:list={[{ on: h === '/' ? path === '/' : path.startsWith(h) }]}>{l}</a>)}</nav>
  <div class="socials">{socials.map((x) => <a href={x.url} target="_blank" rel="noopener noreferrer" aria-label={x.name} title={x.name}><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={x.path} /></svg></a>)}</div>
</header>
<main><slot /></main>
<img class="corner" src="/images/v.png" alt="" width="56" height="56" />
<footer>© 2026 Varnison Studios. All Rights Reserved<br />A Varnagiris Company</footer>
<style is:global>
:root{--p:#a78bfa;--cy:#22d3ee;--mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;--glow:0 0 8px #fff,0 0 22px #a78bfa,0 0 40px #7c3aed}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:#f4f0ff;line-height:1.6;min-height:100vh}
.sky{position:fixed;inset:0;z-index:-1;background:
 linear-gradient(rgba(167,139,250,.07) 1px,transparent 1px) 0 0/40px 40px,
 linear-gradient(90deg,rgba(34,211,238,.06) 1px,transparent 1px) 0 0/40px 40px,
 radial-gradient(ellipse 70% 40% at 15% 100%,rgba(124,58,237,.45),transparent 70%),
 radial-gradient(ellipse 60% 35% at 90% 100%,rgba(59,130,246,.35),transparent 70%),
 radial-gradient(ellipse 50% 30% at 50% 0%,rgba(34,211,238,.12),transparent 70%),
 linear-gradient(180deg,#05060f 0%,#0a0b1e 60%,#14104a 100%)}
header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem 1rem;padding:.7rem 1.2rem;background:rgba(6,7,20,.7);backdrop-filter:blur(12px);border-bottom:1px solid rgba(34,211,238,.25);box-shadow:0 1px 18px rgba(124,58,237,.3);position:sticky;top:0;z-index:5;font-family:var(--mono)}
nav{display:flex;gap:1.1rem;flex:1;justify-content:center}
.socials{display:flex;gap:.35rem}
.socials a{display:grid;place-items:center;width:34px;height:34px;border-radius:8px;color:#c4b5fd;border:1px solid rgba(167,139,250,.25);transition:.15s}
.socials a:hover{color:var(--cy);border-color:var(--cy);box-shadow:0 0 12px var(--cy);transform:translateY(-2px)}
.mono{font-family:var(--mono)}
.cursor{display:inline-block;width:.6ch;animation:blink 1s steps(2) infinite;color:var(--cy)}
@keyframes blink{50%{opacity:0}}
.tagline{font-family:var(--mono);color:var(--cy);font-size:clamp(.9rem,3.5vw,1.2rem);text-shadow:0 0 10px rgba(34,211,238,.6)}
@media(max-width:640px){nav{order:3;flex-basis:100%;justify-content:center;margin:0}}
.brand{display:flex;align-items:center;gap:.6rem;font-weight:800;letter-spacing:.15em;font-family:var(--mono);color:#fff;text-decoration:none;text-shadow:var(--glow)}
.brand img{border-radius:50%}
.corner{position:fixed;right:14px;bottom:14px;z-index:4;border-radius:50%;opacity:.85;box-shadow:0 0 18px #7c3aed;pointer-events:none}
nav a{color:#ddd6fe;text-decoration:none;font-weight:700;font-size:.9rem;text-transform:lowercase}nav a:before{content:'/';color:var(--cy);margin-right:.15rem}
nav a.on,nav a:hover{color:#fff;text-shadow:var(--glow)}
main{max-width:1000px;margin:0 auto;padding:1.5rem 1.2rem 3rem}
h1,h2{color:#fff;text-shadow:var(--glow);letter-spacing:.04em;font-family:var(--mono)}
h2:before{content:'// ';color:var(--cy);text-shadow:0 0 10px var(--cy)}
a{color:#c4b5fd}
footer{text-align:center;padding:2rem 1rem;color:#a5b4fc;font-size:.85rem;border-top:1px solid rgba(167,139,250,.2)}
.card{background:rgba(20,18,60,.45);backdrop-filter:blur(10px);border:1px solid rgba(167,139,250,.3);border-radius:14px;overflow:hidden;text-decoration:none;color:inherit;display:block;transition:transform .15s,box-shadow .15s}
.card:hover{transform:translateY(-3px);border-color:var(--cy);box-shadow:0 0 22px rgba(167,139,250,.55),0 0 40px rgba(34,211,238,.25)}
.card img,.ph{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#2b1a6b}
.ph{display:grid;place-items:center;font-size:2rem}
.card .b{padding:.8rem 1rem}
.card h3{margin:.2rem 0;color:#fff}
.meta{font-size:.85rem;color:#c4b5fd;font-family:var(--mono)}
.sortbar{display:flex;align-items:center;gap:.6rem;margin:0 0 1rem;font-family:ui-monospace,monospace;color:#c4b5fd;font-size:.85rem}
.sortbar select{background:#0d0b1a;color:#e9e5ff;border:1px solid rgba(167,139,250,.35);border-radius:8px;padding:.4rem .7rem;font:inherit;cursor:pointer}
.sortbar select:hover,.sortbar select:focus{border-color:#22d3ee;outline:none;box-shadow:0 0 10px rgba(34,211,238,.3)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.2rem}
.tag{font-family:var(--mono);display:inline-block;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;background:#7c3aed;color:#fff;border-radius:99px;padding:.1rem .6rem;margin-right:.4rem}
.sample{background:#f59e0b;color:#1b1147}
.btn{display:inline-block;background:#7c3aed;color:#fff;padding:.5rem 1rem;border-radius:99px;text-decoration:none;font-weight:700}
.btn:hover{box-shadow:0 0 16px #a78bfa}
.panel{background:rgba(20,18,60,.45);backdrop-filter:blur(10px);border:1px solid rgba(167,139,250,.3);border-radius:14px;padding:1rem 1.2rem}
.embed{aspect-ratio:16/9;width:100%;border:0;border-radius:12px}
</style>
</body></html>
